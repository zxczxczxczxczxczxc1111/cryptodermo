{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Разрешения основного окна и окна быстрого доступа. Метка `quick` обязана быть в списке: разрешения выдаются ПО ОКНАМ, и без неё маленькое окно не может ни спрятаться, ни перетащиться, ни обменяться событиями с основным - при этом ошибок не видно, всё просто молча не работает.",
  "windows": [
    "main",
    "quick"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-set-always-on-top",
    "opener:allow-open-url",
    "core:window:allow-set-size",
    "core:window:allow-center",
    "core:window:allow-set-resizable",
    "core:window:allow-hide",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "core:webview:allow-create-webview-window",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:window:allow-set-skip-taskbar"
  ]
}
